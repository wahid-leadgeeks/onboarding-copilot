# Server-only Google integration settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_ID=
SHEETS_SCHEDULE_URL=
SHEETS_WRITE_URL=
SHEETS_DIARY_URL=
# Optional shared-secret header expected by the write proxy (never exposed to the browser)
SHEETS_WRITE_TOKEN=

# Optional automation and AI provider settings
N8N_WEBHOOK_URL=
AI_API_KEY=
AI_API_BASE_URL=

# Groq AI provider (assistant + AI features) — model is configured here, not in code
GROQ_API_KEY=
GROQ_MODEL=
# Optional override of the Groq chat completions endpoint
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
