{
  "name": "onboarding-copilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "sync:diary": "tsx scripts/sync-diary-to-remote-db.ts",
    "sync:schedule": "tsx scripts/sync-schedule-to-remote-db.ts",
    "db:inspect": "tsx scripts/db-inspect.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:baseline-sql": "tsx scripts/print-baseline-sql.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
