    "postgres": "^3.4.9",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "latest",
    "jest": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
